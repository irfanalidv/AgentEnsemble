# AgentEnsemble - copy to .env and fill in what you use. Format: KEY=value
#
# LLM provider: OpenAI is used when OPENAI_API_KEY is set, otherwise Mistral.
# Set AGENTENSEMBLE_LLM_PROVIDER=openai|mistral to force one.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1

MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest

# AGENTENSEMBLE_LLM_PROVIDER=openai

# Web search (Serper). Without it, SearchTool falls back to DuckDuckGo.
SERPER_API_KEY=
